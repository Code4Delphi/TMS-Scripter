        <None Include="Scripts\Campanha.psc"/>
        <BusinessRuleScript Include="Scripts\*.psc"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
    </ItemGroup>
