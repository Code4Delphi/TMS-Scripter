<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{ED7DA86C-7941-47D4-A3C8-8B2765074217}</ProjectGuid>
        <ProjectVersion>20.3</ProjectVersion>
        <FrameworkType>VCL</FrameworkType>
        <AppType>Application</AppType>
        <MainSource>ScripterDiscountRules.dpr</MainSource>
        <ProjectName>ScripterBusinessRules</ProjectName>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Base</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <TargetedPlatforms>3</TargetedPlatforms>
        <ImportEnvOptions>false</ImportEnvOptions>
        <DelphiLibraryPath>$(BDS)\lib\$(Platform)\release</DelphiLibraryPath>
        <DelphiDebugDCUPath>$(BDS)\lib\$(Platform)\debug</DelphiDebugDCUPath>
        <TMSScripterDir Condition="'$(TMSScripterDir)'==''">$(LOCALAPPDATA)\TMS Setup\Products\tms.biz.scripter</TMSScripterDir>
        <ProjectName Condition="'$(ProjectName)'==''">ScripterDiscountRules</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>DCU\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_ExeOutput>Bin\$(Platform)</DCC_ExeOutput>
        <DCC_Namespace>System;Xml;Data;Vcl;Vcl.Imaging;Winapi;System.Win;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>$(TMSScripterDir)\source\core;$(TMSScripterDir)\source\ide;$(TMSScripterDir)\source\memo;$(TMSScripterDir)\source\vcl;$(TMSScripterDir)\source\imports\rtl;$(TMSScripterDir)\source\imports\vcl;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_UsePackage>;$(DCC_UsePackage)</DCC_UsePackage>
        <Icon_MainIcon>$(BDS)\bin\delphi_PROJECTICON.ico</Icon_MainIcon>
        <Manifest_File>$(BDS)\bin\default_app.manifest</Manifest_File>
        <VerInfo_Locale>1046</VerInfo_Locale>
        <AppDPIAwarenessMode>PerMonitorV2</AppDPIAwarenessMode>
        <SanitizedProjectName>ScripterDiscountRules</SanitizedProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="Src\Main.View.pas">
            <Form>MainView</Form>
            <FormType>dfm</FormType>
        </DCCReference>
        <DCCReference Include="Src\Calculator.pas"/>
